<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_marginTop="8dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:hint="Data Type">
        <AutoCompleteTextView
            android:id="@+id/data_type_auto_complete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/is_available_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available" />

        <CheckBox
            android:id="@+id/is_user_enabled_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Enabled" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/is_visible_in_matchmaking_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Visible in Matchmaking" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/symptom_type_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:hint="Symptom Type"
        android:visibility="gone">
        <AutoCompleteTextView
            android:id="@+id/symptom_type_auto_complete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/remove_data_type_button"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remove Data Type"
        android:layout_gravity="end"
        android:textColor="@android:color/holo_red_dark" />

</LinearLayout>