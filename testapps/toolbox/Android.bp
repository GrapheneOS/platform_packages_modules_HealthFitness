package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "healthConnectToolbox-sources",
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
}

android_library {
    name: "HealthConnectToolboxLibrary",
    srcs: [":healthConnectToolbox-sources"],
    sdk_version: "module_current",
    min_sdk_version: "34",
    libs: [
        "kotlin-annotations",
        "framework-healthfitness.stubs.module_lib",
    ],
    static_libs: [
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "kotlinx_serialization_core",
        "androidx.documentfile_documentfile",
        "androidx.navigation_navigation-common-ktx",
        "androidx.navigation_navigation-fragment-ktx",
        "androidx.navigation_navigation-runtime-ktx",
        "androidx.navigation_navigation-ui-ktx",
        "androidx.annotation_annotation",
        "androidx.work_work-runtime",
        "androidx.concurrent_concurrent-futures-ktx",
        "androidx.activity_activity-compose",
        "androidx.compose.foundation_foundation",
        "androidx.compose.runtime_runtime",
        "androidx.compose.runtime_runtime-livedata",
        "androidx.compose.ui_ui",
        "androidx.navigation_navigation-compose",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "androidx.compose.ui_ui-tooling",
    ],
    kotlincflags: ["-Xjvm-default=all"],
    kotlin_plugins: [
        "kotlin-serialize-compiler-plugin",
    ],
    lint: {
        baseline_filename: "lint-baseline.xml",
    },
}

android_app {
    name: "HealthConnectToolbox1",
    sdk_version: "module_current",
    min_sdk_version: "34",
    rename_resources_package: false,
    updatable: true,
    package_name: "com.android.healthconnect.testapps.toolboxcombined",
    manifest: "AndroidManifestToolboxCombined1.xml",
    additional_manifests: [
        "AndroidManifest.xml",
        "AndroidManifestFitnessPermissions.xml",
        "AndroidManifestMedicalPermissions.xml",
        "AndroidManifestAdditionalPermissions.xml",
    ],
    certificate: "platform",
    static_libs: [
        "HealthConnectToolboxLibrary",
    ],
}

