<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.android.settingslib.widget.BannerMessagePreferenceGroup
        android:key="banner_group"
        app:expandTitle="@string/banner_group_more_items"
        app:collapseTitle="@string/banner_group_fewer_items"
        app:collapseIcon="?attr/collapseIcon"
        android:order="0"/>
    <PreferenceCategory
        android:key="your_health_apps"
        android:title="@string/your_health_apps_category_title"
        android:order="1">
    </PreferenceCategory>
    <PreferenceCategory
        android:key="your_health_data"
        android:title="@string/your_health_data_category_title"
        android:order="2">
        <com.android.healthconnect.controller.shared.preference.HealthPreference
            android:key="data_and_access"
            android:title="@string/data_title"
            android:summary="@string/data_and_access_summary"/>
        <com.android.healthconnect.controller.shared.preference.HealthPreference
            android:key="recent_access"
            android:title="@string/recent_access_header"
            android:summary="@string/recent_access_summary"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:key="preferences"
        android:title="@string/preferences_category_title"
        android:order="3">
        <com.android.healthconnect.controller.shared.preference.HealthPreference
            android:key="devices"
            android:title="@string/devices_title"
            android:summary="@string/home_devices_summary"/>
        <com.android.healthconnect.controller.shared.preference.HealthPreference
            android:key="manage_data"
            android:title="@string/manage_data_section"
            android:summary="@string/manage_data_summary"/>
    </PreferenceCategory>
    <com.android.settingslib.widget.FooterPreference
        android:key="footer"
        android:title="@string/home_screen_footer"/>
</androidx.preference.PreferenceScreen>