<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/device_data_provider_screen_title">

    <PreferenceCategory android:key="device_header_category" />

    <com.android.healthconnect.controller.shared.preference.HealthMainSwitchPreference android:key="device_sync_pref" />

    <PreferenceCategory android:key="device_write_category" />

    <PreferenceCategory android:key="device_data_category">

        <com.android.healthconnect.controller.shared.preference.HealthPreference
            android:key="device_data_button"
            app:persistent="false" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference android:key="connected_app_footer" />

</PreferenceScreen>