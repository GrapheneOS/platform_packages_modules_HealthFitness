<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/device_data_provider_nav_graph"
    app:startDestination="@id/deviceDataProviderFragment">

    <include app:graph="@navigation/app_data_nav_graph" />
    <include app:graph="@navigation/current_device_management_nav_graph" />

    <fragment
        android:id="@+id/deviceDataProviderFragment"
        android:name="com.android.healthconnect.controller.newDevices.DeviceDataProviderFragment"
        android:label="@string/device_data_provider_screen_title">
        <argument
            android:name="android.intent.extra.PACKAGE_NAME"
            app:argType="string" />
        <action
            android:id="@+id/action_deviceDataProviderFragment_to_appData"
            app:destination="@id/app_data_nav_graph" />
        <action
            android:id="@+id/action_deviceDataProviderFragment_to_currentDeviceManagementFragment"
            app:destination="@id/current_device_management_nav_graph" />
    </fragment>

</navigation>