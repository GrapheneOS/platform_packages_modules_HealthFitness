// A group of files known not to work with deviceless (aka bivalent aka robolectric) tests
filegroup {
    name: "robo-ui-tests-sources-exclude",
    srcs: [
        // TODO: b/419191898 - Update this to get as many Controller tests bivalent as possible
        // This gets an "NoActivityResumedException" on two tests. Needs more investigation
        // However, does use "showOnboarding()" which might not work on robolectric as it uses
        // SharedPreferences.
        "src/com/android/healthconnect/controller/tests/data/DataManagementActivityTest.kt",
        // This needs more investigation
        "src/com/android/healthconnect/controller/tests/data/access/LoadAccessUseCaseTest.kt",
        // This test is not finding something in the view. Needs more investigation.
        "src/com/android/healthconnect/controller/tests/data/entries/MockedAllEntriesFragmentTest.kt",
        // This test asserts that an intent is fired. But the code just exits the activity, so
        // an intent is not fired under robolectric. The test could be modified to instead check
        // exit status, but needs some work to work bivalently and be a good test.
        "src/com/android/healthconnect/controller/tests/exportimport/ImportConfirmationDialogFragmentTest.kt",
        // The calls to startActivity are not starting the activity in this class under Robolectric
        "src/com/android/healthconnect/controller/tests/migration/MigrationActivityTest.kt",
        // This code likely needs to be refactored to use Intents to avoid race conditions when
        // detecting the started activity under robolectric.
        "src/com/android/healthconnect/controller/tests/navigation/TrampolineActivityTest.kt",
        // Needs more investigation. Just faking the appInfoReader causes the on device test to
        // fail, and isn't enough to get the robo test working.
        "src/com/android/healthconnect/controller/tests/recentaccess/RecentAccessViewModelTest.kt",
        // The first click on some preferences doesn't seem to create a view that can be found for
        // the second click. To be investigated.
        "src/com/android/healthconnect/controller/tests/units/UnitsFragmentTest.kt",
        // It seems like Localization data (specifically WeekFields) are not fetched correctly
        // under robolectric.
        "src/com/android/healthconnect/controller/tests/utiltests/TimeUtilsTest.kt",
    ],
    path: "src",
}

// Robolectric test target for testing Health Connect Controller APK UI
// This target is currently under development to allow bivalent tests
// go/deviceless-tests
android_robolectric_test {
    name: "HealthConnectControllerRoboUITests",
    sdk_version: "module_current",
    srcs: [
        // TODO: b/419191898 - Update this to get as many Controller tests bivalent as possible
        "src/com/android/healthconnect/controller/tests/TestActivity.kt",
        "src/com/android/healthconnect/controller/tests/autodelete/**/*.kt",
        "src/com/android/healthconnect/controller/tests/backuprestore/**/*.kt",
        "src/com/android/healthconnect/controller/tests/data/**/*.kt",
        "src/com/android/healthconnect/controller/tests/datasources/**/*.kt",
        "src/com/android/healthconnect/controller/tests/exportimport/**/*.kt",
        "src/com/android/healthconnect/controller/tests/home/**/*.kt",
        "src/com/android/healthconnect/controller/tests/managedata/**/*.kt",
        "src/com/android/healthconnect/controller/tests/migration/**/*.kt",
        "src/com/android/healthconnect/controller/tests/navigation/**/*.kt",
        "src/com/android/healthconnect/controller/tests/onboarding/**/*.kt",
        "src/com/android/healthconnect/controller/tests/recentaccess/**/*.kt",
        "src/com/android/healthconnect/controller/tests/units/**/*.kt",
        "src/com/android/healthconnect/controller/tests/utils/**/*.kt",
        "src/com/android/healthconnect/controller/tests/utiltests/**/*.kt",
    ],
    exclude_srcs: [
        "src/**/safetycenter/*.kt",
        ":robo-ui-tests-sources-exclude",
    ],
    // Enable robolectric changes we need for tests, that were contributed back and aren't default
    // yet.
    test_options: {
        test_runner_options: [
            {
                name: "java-flags",
                value: "-Drobolectric.allowPlatformPermissions=true",
            },
            {
                name: "java-flags",
                value: "-Drobolectric.looperMode=INSTRUMENTATION_TEST",
            },
        ],
    },
    // defaults : ["health-connect-controller-tests-default"],
    static_libs: [
        // This is required to get mocking of final classes
        "inline-mockito5-robolectric-prebuilt",
        "mockito-kotlin-nodeps",
        "androidx.test.core",
        "androidx.test.ext.junit",
        "framework-healthfitness.impl",
        "HealthConnectPermissionsApis",
        "HealthConnectOnboardingApis",
        "HealthConnectMigrationApis",
        "HealthConnectExportApis",
        "HealthConnectLibrary",
        "hilt_android_testing",
        "kotlinx_coroutines_test",
        // test dependencies
        "androidx.navigation_navigation-testing",
        "androidx.test.espresso.contrib",
        "androidx.test.espresso.intents",
        "androidx.test.espresso.core",
        "androidx.test.ext.junit",
        "androidx.test.ext.truth",
        "androidx.test.rules",
        "flag-junit",
    ],
    java_resource_dirs: ["config"],
    instrumentation_for: "RoboTestApp",
}

// An app for robolectric to use to get the resources, and manifest
// Loads AndroidTest.xml from this directory.
android_app {
    name: "RoboTestApp",
    platform_apis: true,
    // Even though this is never run on the device, Soong complains if the libraries don't match
    // the manifest. Add the libraries here.
    // https://source.android.com/docs/core/runtime/art-class-loader-context
    uses_libs: [
        "android.test.runner",
    ],
    static_libs: [
        "HealthConnectLibrary",
    ],
    // Even though this is never run on the device, Soong complains if the libraries don't match
    // the manifest. Add the libraries here.
    // https://source.android.com/docs/core/runtime/art-class-loader-context
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
        "org.apache.http.legacy",
        "wear-sdk",
    ],
}
