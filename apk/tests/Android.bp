package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_android_health",
}

filegroup {
    name: "healthconnect-test-srcs",
    srcs: [
        "src/com/android/healthconnect/controller/tests/utils/**/*.java",
        "src/com/android/healthconnect/controller/tests/utils/**/*.kt",
        "src/**/HiltTestRunner.kt",
        "src/**/TestActivity.kt",
    ],
    visibility: [
        "//vendor:__subpackages__",
    ],
}

filegroup {
    name: "healthconnect-tests-screenshot-srcs",
    srcs: [
        "src/**/HiltTestRunner.kt",
        "src/**/TestActivity.kt",
        "src/com/android/healthconnect/controller/tests/utils/TestConstants.kt",
        "src/com/android/healthconnect/controller/tests/utils/ScrollingUtils.kt",
    ],
    visibility: [
        "//vendor:__subpackages__",
    ],
}

java_defaults {
    name: "health-connect-controller-tests-default",
    srcs: [":healthconnect-test-srcs"],
    kotlin_lang_version: "1.9",
    defaults: ["modules-utils-testable-device-config-defaults"],
    sdk_version: "module_current",
    min_sdk_version: "34",
    static_libs: [
        "androidx.test.core",
        "androidx.test.rules",
        "HealthConnectPermissionsApis",
        "HealthConnectLibrary",
        "SettingsLibSettingsTheme",
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "androidx.navigation_navigation-common-ktx",
        "androidx.navigation_navigation-fragment-ktx",
        "androidx.navigation_navigation-runtime-ktx",
        "androidx.navigation_navigation-ui-ktx",
        "androidx.navigation_navigation-testing",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibHelpUtils",
        "SettingsLibTopIntroPreference",
        "SettingsLibFooterPreference",
        "androidx.annotation_annotation",
        "hilt_android_testing",
        "kotlinx_coroutines_test",
        // test dependencies
        "androidx.test.espresso.contrib",
        "androidx.test.espresso.intents",
        "androidx.test.espresso.core",
        "androidx.test.ext.junit",
        "androidx.test.ext.truth",
        "androidx.test.rules",
        "compatibility-device-util-axt",
        "mockito-kotlin2",
        "platform-parametric-runner-lib",
        "android.permission.flags-aconfig-java-export",
        "collector-device-lib",
        "aconfig_settingstheme_exported_flags_java_lib",
    ],
    libs: [
        "kotlin-annotations",
        "android.test.base.stubs.system",
        "android.test.mock.stubs",
        "framework-healthfitness.impl",
    ],
    kotlincflags: ["-Xjvm-default=all"],
    test_suites: [
        "general-tests",
        "mts-healthfitness",
    ],
    test_mainline_modules: ["com.google.android.healthfitness.apex"],
    data: [
        ":HealthConnectUITestApp",
        ":HealthConnectUITestApp2",
        ":UnsupportedTestApp",
        ":OldPermissionsTestApp",
        ":MedicalPermissionsTestApp",
        ":NoPermissionsTestApp",
        ":HealthConnectUIBodySensorsTestApp",
        ":HealthConnectUIBodySensorsAndHealthTestApp",
        ":HealthConnectUIWearTestApp",
    ],
    test_config_template: "AndroidTestTemplate.xml",
    visibility: ["//visibility:private"],
}

