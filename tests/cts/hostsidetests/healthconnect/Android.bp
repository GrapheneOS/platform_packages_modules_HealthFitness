package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_test_host {
    name: "CtsHealthConnectHostTestCases",
    team: "trendy_team_android_health",
    defaults: ["cts_defaults"],
    srcs: [
        "host/**/*.java",
        "host/**/*.kt",
    ],
    test_suites: [
        // These tests are named CTS but are excluded from the standard CTS suite.
        // They are incompatible with MCTS due to proto mismatches with Mainline updates
        // (see b/358006651) and do not test core CTS requirements.
        "general-tests",
        "mts-healthfitness",
    ],
    libs: [
        "compatibility-host-util",
        "cts-tradefed",
        "tradefed",
        "truth",
    ],
    static_libs: [
        "cts-statsd-atom-host-test-utils",
        "androidx.annotation_annotation",
        "flag-junit-host",
        "healthfitness-aconfig-flags-lib-host",
        "platformprotos",
    ],
    java_resource_dirs: ["host/res"],
    device_common_data: [
        ":CtsHealthConnectTestAppForHostTest",
    ],
    enable_static_aconfig_pb: true,
}
