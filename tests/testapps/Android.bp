package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Library for test apps used by cts / integration tests.
android_library {
    name: "healthfitness-testing-testapp",
    manifest: "AndroidManifest_testapp.xml",
    srcs: [
        "src/android/healthconnect/testing/testapp/**/*.java",
    ],
    static_libs: [
        "healthfitness-aconfig-flags-lib",
        "healthfitness-aconfig-flags-helper",
        "healthfitness-testing-shared",
        "healthfitness-testing-cts",
    ],
    min_sdk_version: "34",
    sdk_version: "test_current",
}

android_test_helper_app {
    name: "CtsHealthConnectTestAppAWithNormalReadWritePermission",
    manifest: "CtsHealthConnectTestAppAWithNormalReadWritePermission.xml",
    static_libs: [
        "healthfitness-testing-testapp",
    ],
    sdk_version: "test_current",
    min_sdk_version: "34",
    target_sdk_version: "34",
    flags_packages: [
        "healthfitness-aconfig-flags",
    ],
}

android_test_helper_app {
    name: "CtsHealthConnectTestAppBWithNormalReadWritePermission",
    manifest: "CtsHealthConnectTestAppBWithNormalReadWritePermission.xml",
    static_libs: [
        "healthfitness-testing-testapp",
    ],
    sdk_version: "test_current",
    min_sdk_version: "34",
    target_sdk_version: "34",
    flags_packages: [
        "healthfitness-aconfig-flags",
    ],
}

android_test_helper_app {
    name: "CtsHealthConnectTestAppWithDataManagePermission",
    manifest: "CtsHealthConnectTestAppWithDataManagePermission.xml",
    static_libs: [
        "healthfitness-testing-testapp",
    ],
    sdk_version: "test_current",
    min_sdk_version: "34",
    target_sdk_version: "34",
}

android_test_helper_app {
    name: "CtsHealthConnectTestAppWithNoPermission",
    manifest: "CtsHealthConnectTestAppWithNoPermission.xml",
    static_libs: [
        "healthfitness-testing-testapp",
    ],
    sdk_version: "test_current",
    min_sdk_version: "34",
    target_sdk_version: "34",
}

android_test_helper_app {
    name: "CtsHealthConnectTestAppWithWritePermissionsOnly",
    manifest: "CtsHealthConnectTestAppWithWritePermissionsOnly.xml",
    static_libs: [
        "healthfitness-testing-testapp",
    ],
    sdk_version: "test_current",
    min_sdk_version: "34",
    target_sdk_version: "34",
    flags_packages: [
        "healthfitness-aconfig-flags",
    ],
}

android_test_helper_app {
    name: "CtsHealthConnectTestAppForHostTest",
    manifest: "CtsHealthConnectTestAppForHostTest.xml",
    defaults: ["cts_defaults"],
    platform_apis: true,
    srcs: [
        "src/android/healthconnect/cts/hosttestapp/**/*.java",
        "src/android/healthconnect/cts/hosttestapp/**/*.kt",
    ],
    static_libs: [
        "ctstestrunner-axt",
        "healthfitness-testing-cts",
        "healthfitness-testing-testapp",
    ],
    libs: ["junit"],
    sdk_version: "test_current",
    min_sdk_version: "34",
    target_sdk_version: "34",
}

android_test_helper_app {
    name: "HealthFitnessCtsSystemTestApp",
    manifest: "CtsSystemTestAppAndroidManifest.xml",
    static_libs: [
        "healthfitness-testing-testapp",
    ],
    defaults: ["cts_defaults"],
    sdk_version: "test_current",
    min_sdk_version: "34",
    target_sdk_version: "34",
}
